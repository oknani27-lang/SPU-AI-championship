# ============================================================
# CarePlan — AI Weekly Care Scheduler Environment Template
# Copy to .env.local and fill real values locally.
# NEVER commit .env or .env.local to Git.
# All keys below are SERVER-ONLY (never exposed to browser).
# ============================================================

# Existing configured AI provider (Google Gemini)
GEMINI_API_KEY=ใส่_Gemini_API_Key
GEMINI_MODEL=gemini-2.5-flash

# Existing Supabase project (server-only keys — preserved compatibility)
SUPABASE_URL=https://ngkwsavxyyaeygduzvqc.supabase.co
SUPABASE_PUBLISHABLE_KEY=ใส่_Publishable_Key
SUPABASE_SECRET_KEY=ใส่_Secret_Key

# Optional standard aliases (supported automatically if set)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Application URL (used for shareable schedule links)
APP_BASE_URL=http://localhost:3000

# Cron endpoint protection for Smart Reminder background runner
CRON_SECRET=replace_with_random_cron_secret

# Optional: set to "true" to enable clearly labeled Hackathon Demo Mode when live Supabase is not yet migrated
CAREPLAN_DEMO_MODE=false
